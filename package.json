{
  "name": "@keboola/n8n-nodes-keboola",
  "version": "0.1.0",
  "description": "n8n node to interact with Keboola Storage APIs & MCP Server",
  "author": {
    "name": "Keboola",
    "email": "support@keboola.com",
    "url": "https://www.keboola.com"
  },
  "contributors": [
    {
      "name": "Radek Tomasek",
      "email": "radek.tomasek@keboola.com"
    }
  ],
  "keywords": [
    "n8n",
    "keboola",
    "integration",
    "nodes",
    "n8n-community-node-package"
  ],
  "type": "commonjs",
  "license": "MIT",
  "homepage": "https://github.com/keboola/n8n-nodes-keboola#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/keboola/n8n-nodes-keboola.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/keboola/n8n-nodes-keboola/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier nodes credentials --write",
    "lint": "eslint \"{nodes,credentials}/**/*.ts\" package.json",
    "lintfix": "eslint \"{nodes,credentials}/**/*.ts\" package.json --fix",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
    "changeset": "changeset"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KeboolaStorageApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Keboola/Keboola.node.js"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.0.13",
    "@typescript-eslint/parser": "~8.32.0",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "zod": "^4.1.11"
  },
  "overrides": {
    "axios": "^1.12.0",
    "form-data": "^4.0.4"
  }
}
